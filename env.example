# Copy this file to .env and fill in your values (dotenv loads .env, NOT .env.agents)
# cp agents/env.example agents/.env

# Discord Application Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=

# Discord Server (Guild) ID — right click server → Copy Server ID (Dev Mode must be on)
GUILD_ID=1502665249336332450

# OpenRouter API Key — reuses the same key as Hermes (.hermes/.env)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Channel IDs (right click channel → Copy Channel ID)
CHANNEL_AI_TEAM_INPUT=
CHANNEL_AI_TEAM_OUTPUT=
CHANNEL_CTO=
CHANNEL_MARKETING=
CHANNEL_PO=
CHANNEL_DEV=
CHANNEL_AGENT_LOGS=

# Optional: override transport at runtime (discord | cli)
# TRANSPORT=cli
